# The API uses these same Data Lake variables as Dagster/dbt when
# DATABASE_URL is not set.
DATALAKE_DB_HOST=localhost
DATALAKE_DB_PORT=5432
DATALAKE_DB_USER=postgres
DATALAKE_DB_PASSWORD=postgres
DATALAKE_DB_NAME=nvdatalake

# PostgreSQL TLS mode: require encrypts traffic; verify-full also validates
# the server certificate and can use PGSSLROOTCERT when a CA file is mounted.
PGSSLMODE=require

# JWT and refresh-token settings
AUTH_JWT_SECRET=replace-with-a-random-32-byte-secret
AUTH_JWT_ISSUER=nv-datalake-api
AUTH_JWT_AUDIENCE=nv-datalake-web
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=nv_refresh
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PORT=3001
