# Copy to .env and fill in real values. .env is gitignored — never commit credentials.

# Source db "nvtr" (schema ce_eusebio)
SOURCE_NVTR_CE_EUSEBIO_DB_HOST=localhost
SOURCE_NVTR_CE_EUSEBIO_DB_PORT=5432
SOURCE_NVTR_CE_EUSEBIO_DB_USER=postgres
SOURCE_NVTR_CE_EUSEBIO_DB_PASSWORD=postgres
SOURCE_NVTR_CE_EUSEBIO_DB_NAME=nvtr

# Source db "nvtr" (schema ce_aquiraz)
SOURCE_NVTR_CE_AQUIRAZ_DB_HOST=localhost
SOURCE_NVTR_CE_AQUIRAZ_DB_PORT=5432
SOURCE_NVTR_CE_AQUIRAZ_DB_USER=postgres
SOURCE_NVTR_CE_AQUIRAZ_DB_PASSWORD=postgres
SOURCE_NVTR_CE_AQUIRAZ_DB_NAME=nvtr

# Destination db (nvdatalake)
DATALAKE_DB_HOST=localhost
DATALAKE_DB_PORT=5432
DATALAKE_DB_USER=postgres
DATALAKE_DB_PASSWORD=postgres
DATALAKE_DB_NAME=nvdatalake
