# Copy to .env and fill in real values. .env is gitignored — never commit credentials.

# Source db "nvtr" (shared across all its schemas: ce_eusebio, ce_aquiraz, ...)
SOURCE_NVTR_DB_HOST=localhost
SOURCE_NVTR_DB_PORT=5432
SOURCE_NVTR_DB_USER=postgres
SOURCE_NVTR_DB_PASSWORD=postgres
SOURCE_NVTR_DB_NAME=nvtr

# Destination db (nvdatalake)
DATALAKE_DB_HOST=localhost
DATALAKE_DB_PORT=5432
DATALAKE_DB_USER=postgres
DATALAKE_DB_PASSWORD=postgres
DATALAKE_DB_NAME=nvdatalake

# PostgreSQL TLS mode for dbt and the API
PGSSLMODE=require

# API authentication
AUTH_JWT_SECRET=replace-with-a-random-32-byte-secret
AUTH_JWT_ISSUER=nv-datalake-api
AUTH_JWT_AUDIENCE=nv-datalake-web
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=nv_refresh
AUTH_COOKIE_SECURE=false
# Docker Compose web origin (include the public origin when deploying).
AUTH_ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
API_PORT=3001
WEB_PORT=8080
